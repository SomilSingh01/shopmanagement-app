{
  "info": {
    "name": "ShopManager API",
    "description": "Every API endpoint created in the ShopManager backend, including its HTTP method, URL, and an explanation of why it was created and what it does.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type","value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin\",\n  \"email\": \"admin@shop.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {"raw": "http://localhost:5000/api/v1/auth/register","host": ["http://localhost:5000"],"path": ["api","v1","auth","register"]},
            "description": "Why: We need a way for new administrators/store owners to create an account. It securely hashes their password using Bcrypt before saving it to MySQL."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type","value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"admin@shop.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {"raw": "http://localhost:5000/api/v1/auth/login","host": ["http://localhost:5000"],"path": ["api","v1","auth","login"]},
            "description": "Why: To authenticate users. It verifies their email/phone and password, and if correct, issues a JWT (Access Token)."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {"raw": "http://localhost:5000/api/v1/auth/logout","host": ["http://localhost:5000"],"path": ["api","v1","auth","logout"]},
            "description": "Why: To allow the frontend to trigger a logout flow."
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "http://localhost:5000/api/v1/auth/me","host": ["http://localhost:5000"],"path": ["api","v1","auth","me"]},
            "description": "Why: Decodes the token and returns the user's profile to display in the header."
          }
        }
      ]
    },
    {
      "name": "2. Dashboard",
      "item": [
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "http://localhost:5000/api/v1/dashboard/stats","host": ["http://localhost:5000"],"path": ["api","v1","dashboard","stats"]},
            "description": "Why: The dashboard needs top-level metrics. Runs Prisma aggregations to calculate instantly on the DB side."
          }
        },
        {
          "name": "Low Stock Alerts",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "http://localhost:5000/api/v1/dashboard/low-stock","host": ["http://localhost:5000"],"path": ["api","v1","dashboard","low-stock"]},
            "description": "Why: Proactively alerts the store owner. Filters inventory for top 10 items with critically low stock."
          }
        },
        {
          "name": "Recent Orders",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "http://localhost:5000/api/v1/dashboard/recent-orders","host": ["http://localhost:5000"],"path": ["api","v1","dashboard","recent-orders"]},
            "description": "Why: Efficiently grabs the last 5 transactions without slowing down the server."
          }
        }
      ]
    },
    {
      "name": "3. Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "http://localhost:5000/api/v1/products","host": ["http://localhost:5000"],"path": ["api","v1","products"]},
            "description": "Why: To populate the main Inventory/Products table on the frontend."
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "http://localhost:5000/api/v1/products/:id","host": ["http://localhost:5000"],"path": ["api","v1","products",":id"]},
            "description": "Why: Fetches specific details (price, stock, description) for editing."
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"},{"key": "Content-Type","value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Product\",\n  \"price\": 99.99,\n  \"stock\": 50\n}"
            },
            "url": {"raw": "http://localhost:5000/api/v1/products","host": ["http://localhost:5000"],"path": ["api","v1","products"]},
            "description": "Why: To add new inventory to the store with Zod validation."
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"},{"key": "Content-Type","value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 89.99\n}"
            },
            "url": {"raw": "http://localhost:5000/api/v1/products/:id","host": ["http://localhost:5000"],"path": ["api","v1","products",":id"]},
            "description": "Why: To update an existing product (e.g., changing price or stock)."
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "http://localhost:5000/api/v1/products/:id","host": ["http://localhost:5000"],"path": ["api","v1","products",":id"]},
            "description": "Why: To permanently remove a product from the catalog."
          }
        }
      ]
    },
    {
      "name": "4. Customers",
      "item": [
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "http://localhost:5000/api/v1/customers","host": ["http://localhost:5000"],"path": ["api","v1","customers"]},
            "description": "Why: To list all buyers in the system."
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"},{"key": "Content-Type","value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {"raw": "http://localhost:5000/api/v1/customers","host": ["http://localhost:5000"],"path": ["api","v1","customers"]},
            "description": "Why: To create a new customer record."
          }
        }
      ]
    },
    {
      "name": "5. Orders",
      "item": [
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "http://localhost:5000/api/v1/orders","host": ["http://localhost:5000"],"path": ["api","v1","orders"]},
            "description": "Why: To populate the Order Management screen."
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"},{"key": "Content-Type","value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"uuid-goes-here\",\n  \"items\": [\n    {\n      \"productId\": \"uuid-goes-here\",\n      \"quantity\": 2,\n      \"price\": 99.99\n    }\n  ]\n}"
            },
            "url": {"raw": "http://localhost:5000/api/v1/orders","host": ["http://localhost:5000"],"path": ["api","v1","orders"]},
            "description": "Why: Checkout endpoint. Uses a DB Transaction to save order and items simultaneously."
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization","value": "Bearer {{jwt_token}}"},{"key": "Content-Type","value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPED\"\n}"
            },
            "url": {"raw": "http://localhost:5000/api/v1/orders/:id/status","host": ["http://localhost:5000"],"path": ["api","v1","orders",":id","status"]},
            "description": "Why: For Order Fulfillment. Safely updates only the status field."
          }
        }
      ]
    }
  ]
}
